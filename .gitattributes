# DB is now downloaded from GitHub Release at build time (no LFS needed)

# シェルスクリプトは必ず LF で置く。
# Windows でチェックアウトすると CRLF になり、`#!/bin/bash` を
# shebang として解釈できず、Linux コンテナで
#   /bin/sh: 1: scripts/download_db.sh: not found
# と出る（ファイルは存在するのに「無い」と言われる）。
# 2026-09-07 に Docker ビルドの再現でこれを踏んだ。
*.sh text eol=lf

# ts-rs の生成物 (cargo test --lib が LF で書き出す)。チェックアウト時も LF にして、
# Windows で再生成しただけで変更扱いにならないようにする。CI は差分ゼロを検査する。
frontend/src/generated/** text eol=lf

# 競合調査 golden/fixture はバイト単位で比較する。改行変換させない。
tests/fixtures/competitor/** -text
