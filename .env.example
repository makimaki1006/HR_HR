# =============================================================================
# rust_dashboard (HR_HR) 環境変数テンプレート
#
# 使い方: このファイルを .env にコピーして値を入れる。
#         .env は git 管理外(秘密を含む)。
#
# 2026-08-22 全面改訂:
#   旧版は 8 個しか書かれておらず、うち 3 個(TURSO_DATABASE_URL /
#   TURSO_AUTH_TOKEN / LOCAL_DB_PATH)は **コードに存在しなかった**。
#   実装が読んでいるのは 37 個。src/ を全走査して実装に合わせ直した。
#   区分は「未設定のときコードがどう振る舞うか」で決めている。
#
#   TURSO_DATABASE_URL / TURSO_AUTH_TOKEN は
#   docs/SURVEY_MARKET_INTELLIGENCE_PHASE3_F2_IMPLEMENTATION_PLAN.md の
#   **これから作る機能**の計画に出てくる名前。現時点では未実装なので外した。
# =============================================================================


# -----------------------------------------------------------------------------
# 競合調査PDF: PDF_CHROMIUM_PATH は Chromium 実行ファイルの任意の上書き。
# 未設定なら Linux は chromium、Windows は標準の Microsoft Edge を使用。
# PDF_NODE_PATH は Node.js 実行ファイル、PDF_PLAYWRIGHT_MODULE は playwright-core の
# 配置先の任意の上書き。Dockerには両方を同梱し、追加設定は不要です。
# 手動PDFテスト専用: COMPETITOR_PDF_TEST_HTML は検証元レポートHTMLのパス。
# 本番で設定する必要はありません。
#
# 【必須】これが無いと該当機能が明示エラーで止まる
# -----------------------------------------------------------------------------

# Google サービスアカウントの JSON を base64 にしたもの。
# 架電クオリティの全タブは Google スプレッドシートを直接読むため、これが要る。
#   src/db/sheets_client.rs:103  未設定なら「環境変数 GOOGLE_SA_KEY_B64 が未設定」で停止
#
# 作り方(既存の鍵から):
#   base64 -w0 credentials/call_quality_sa.json      # Linux/Mac
# ※ sales-automation 側に base64 済みのものがある:
#   <Hubspotリポジトリ>/credentials/call_quality_sa.base64.txt
GOOGLE_SA_KEY_B64=

# 読み込む対象のスプレッドシート ID (44文字)。
#   src/db/sheets_client.rs:112  未設定なら「環境変数 SPREADSHEET_ID が未設定」で停止
SPREADSHEET_ID=


# -----------------------------------------------------------------------------
# 【認証】実運用では必須。開発でも設定しないとログインできない
# -----------------------------------------------------------------------------

# 社内パスワード(平文)。AUTH_PASSWORD_HASH があればそちらが優先される。
# 🔴 両方とも空だと verify_password() が常に false を返し、**誰もログインできない**
#    (src/auth/mod.rs:164-172。開いてしまうのではなく閉じる側に倒れる)
AUTH_PASSWORD=

# bcrypt ハッシュ。設定するとこちらが使われ、AUTH_PASSWORD は無視される。
AUTH_PASSWORD_HASH=

# ログインを許すメールドメイン(カンマ区切り)。未設定なら f-a-c.co.jp。
ALLOWED_DOMAINS=f-a-c.co.jp

# 追加で許すドメイン(カンマ区切り)。未設定なら無し。
ALLOWED_DOMAINS_EXTRA=

# 期限付きの外部パスワード。書式: パスワード:YYYY-MM-DD をカンマ区切り。
# 期限を過ぎると一致しても弾かれ、期限切れの旨が画面に出る。
AUTH_PASSWORDS_EXTRA=

# 管理者メール(カンマ区切り)。未設定なら管理者なし。
ADMIN_EMAILS=

# Google Workspace OIDC ログイン (ADR-017)。**4 つ全部**入れたときだけ有効。
# 1 つでも空ならログイン画面に Google ボタンを出さず /auth/google/* は 404、
# パスワードログインは従来どおり動く。
#   src/config.rs GoogleOidcConfig::from_env / src/auth/google_oidc.rs
# CLIENT_ID / SECRET は Google Cloud の OAuth クライアント ID (ウェブアプリ)。
# SECRET はブラウザに渡さない。リポジトリに置かない。
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Google Cloud の「承認済みのリダイレクト URI」と完全一致させる。
# 本番: https://hr-hw.onrender.com/auth/google/callback
GOOGLE_OIDC_REDIRECT_URL=
# ID token の hd クレームと email のドメインをこれと照合する (ALLOWED_DOMAINS とは別)。
GOOGLE_OIDC_HOSTED_DOMAIN=
# ローカル E2E 専用 (debug ビルドでのみ読む。release ビルドでは無視される)。
# 手元の偽 Google の Discovery URL を入れる。本番には設定しない。
GOOGLE_OIDC_DISCOVERY_URL_DEBUG=
# debug ビルド専用 (release ビルドでは読まない。本番には設定しない)。
# CSRF の許可 Origin に追加する (カンマ区切り)。PR 時 E2E (ポート 9217) の POST 用。例: http://localhost:9217
CSRF_EXTRA_ORIGINS_DEBUG=
# テスト専用 (cargo test のときだけ読む。本番・開発サーバには設定しない)。
# 1 にすると採用診断の golden JSON snapshot (src/handlers/recruitment_diag/testdata/snapshots/) を書き直す。
UPDATE_RD_SNAPSHOTS=
# テスト専用。管理・個人設定 (W8) の snapshot を書き直す: html / json / all。
W8_WRITE_SNAPSHOTS=


# -----------------------------------------------------------------------------
# 【任意・既定値あり】設定しなくても動く。既定値をコメントに書いてある
# -----------------------------------------------------------------------------

PORT=9216                        # 既定 9216
CACHE_TTL_SECS=1800              # 既定 1800 (30分)
CACHE_MAX_ENTRIES=3000           # 既定 3000
RATE_LIMIT_MAX_ATTEMPTS=5        # 既定 5    ログイン試行の上限
RATE_LIMIT_LOCKOUT_SECONDS=300   # 既定 300  ロックアウト秒数
HELLOWORK_DB_PATH=data/hellowork.db   # 既定 data/hellowork.db
SERPAPI_MONTHLY_CAP=240          # 既定 240  SerpApi の月間上限(使い過ぎ防止)
RUST_LOG=info                    # 既定 info tracing_subscriber の EnvFilter が読む
# コンサルダッシュボードの「HubSpot で開く」リンクと /api/crm/* の deep_link に使う HubSpot の portal_id。
#   src/hubspot/deep_link.rs hubspot_portal_id() (cs_dashboard もここを経由)  未設定・空なら既定 23708633（リクロジ事業部。公開して困る値ではない）
HUBSPOT_PORTAL_ID=23708633       # 既定 23708633


# -----------------------------------------------------------------------------
# 【機能別】未設定ならその機能だけ動かない。起動は妨げない
# -----------------------------------------------------------------------------

# --- HubSpot CRM API (Headless CRM、/api/crm/*) ---
# Bearer トークン。既存の HubSpot Service Key (sales-automation-api) を共有して使う (2026-09-29 ユーザー決定 P-2)。
#   src/config.rs HubSpotApiConfig::from_env  未設定・空なら /api/crm/* は 503 not_configured (他機能は影響なし)
# スコープは読み取りのみを推奨 (crm.objects.contacts.read / companies.read / deals.read / owners.read)。
# 書き込みスコープは PR4 まで付けない。秘密情報: リポジトリに置かず、ログ・応答にも出さない。
# 既存バッチ群とレート上限 (10 秒あたり / Search 5 req/秒) を共有するため、Search は 1 req/秒に絞っている。
HUBSPOT_ACCESS_TOKEN=
# /api/crm/* (メタデータ・レコード読み取り) を読める人: Google Workspace OIDC ログイン かつ このカンマ区切りメールの完全一致。
#   src/crm/rbac.rs CrmAccess::from_env  空なら全員拒否 (403)。変更後は再起動。役割 (RBAC) の本実装までの暫定。
CRM_METADATA_ALLOWED_EMAILS=

# --- Gemini (求人票生成・分析) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- 求人票生成 ---
KNOWLEDGE_DIR=                   # 職種知識の置き場。未設定なら既定の場所
API_AUTH_TOKEN=                  # job_gen の API を叩くためのトークン
CENTROIDS_PATH=                  # 通勤圏の重心データ。未設定なら既定の場所

# --- スカウト ---
SCOUT_ADMIN_TOKEN=

# --- 媒体選定エンジン ---
SERPAPI_CACHE_DIR=               # 未設定なら既定の場所

# --- Indeed 採用市場 ---
# 分析 DB の置き場。未設定なら data/indeed_insights.db。
# 起動時に同名の .gz があればそこから展開する（本番は gz だけを積む）。
INDEED_DB_PATH=data/indeed_insights.db

# 顧客レポート /report/indeed の開閉。
# 🔴 未設定・on 以外なら **404**。社外に配ってよいかの確認が済むまで閉じておく。
#    社内タブ /tab/indeed はこの値に関係なく開いている。
INDEED_PUBLIC=

# 顧客レポートの末尾に出す問い合わせ先。URL か mailto: を入れたときだけ 1 本出る。
# 未設定なら何も出ない（誤った連絡先を載せるより出さない側に倒している）。
INDEED_CONTACT=
# テストのときだけ使う。指定したディレクトリへ、実データを通したレポート HTML を
# そのまま書き出す（図の重なりや印刷の切れ方は読むだけでは分からないため）。
#   CARGO_TARGET_DIR=... INDEED_REPORT_DUMP=/tmp/indeed cargo test レポートを目視用に書き出す
# 空なら何も書かない。サーバの動きには影響しない。
INDEED_REPORT_DUMP=

# --- コンサルダッシュボード (/consulting) ---
# 鮮度の帯に出す自動更新の予定（例: 毎日 21:30）。値はそのまま画面に出る。
# 日次更新はタスクスケジューラ \Consulting\Consulting-daily-collect（2026-09-28 登録、毎日 21:30）。
# 🔴 時刻をコードに直書きしないための変数。未設定なら画面は時刻を言わず
#    「更新は自動で回しています」だけを出す（推測で埋めない）。CS_メタ の「更新の予定」があればそちらが勝つ。
CS_UPDATE_SCHEDULE=

# --- 監査ログ (Turso) ---
# 未設定だと監査ログが記録されないだけで、アプリは動く。
AUDIT_TURSO_URL=
AUDIT_TURSO_TOKEN=
AUDIT_IP_SALT=                   # IPアドレスのハッシュ化に使う塩。未設定なら既定値

# --- SalesNow 連携 (Turso) ---
SALESNOW_TURSO_URL=
SALESNOW_TURSO_TOKEN=

# --- スカウト用DB (Turso) ---
SCOUT_TURSO_URL=
SCOUT_TURSO_TOKEN=

# --- 外部インサイト (Turso) ---
# 🔴 config.rs では空既定だが、src/handlers/insight/fetch.rs:839 は
#    .expect("TURSO_EXTERNAL_URL 未設定") なので、**その経路を叩くと落ちる**。
#    その機能を使うなら必ず設定すること。
TURSO_EXTERNAL_URL=
TURSO_EXTERNAL_TOKEN=


# -----------------------------------------------------------------------------
# 【開発・テスト専用】通常は設定しない
# -----------------------------------------------------------------------------

# 設定するとフィクスチャを吐き出す。未設定なら何もしない(早期 return)。
CONSULT_BRIEF_FIXTURE_OUT=
CONSULT_HEARING_FIXTURE_OUT=

# VRT(見た目の回帰テスト)で時刻を固定する。未設定なら現在時刻。
REPORT_FIXED_TIMESTAMP=

# 営業KPI を Google Sheets なしで起動する（旧画面 /sales-kpi と React 画面 /app/sales-kpi を
# 同じ材料で突き合わせるため。2026-09-30）。設定すると /api/sales-kpi/data は
# このディレクトリの TSV（tests/fixtures/sales_kpi/ と同じ形）から組む。
#   src/handlers/sales_kpi/fixture.rs  未設定なら従来どおり Sheets を読む（本番には置かない）
SALES_KPI_FIXTURE_DIR=
# 判定日 yyyy-MM-dd。未設定なら実際の今日（JST）。fixture の期待値は 2026-09-04 基準。
SALES_KPI_FIXTURE_TODAY=


# -----------------------------------------------------------------------------
# 【ホスティング側が入れる】自分で設定しない
# -----------------------------------------------------------------------------
# RENDER              Render 上かどうかの判定に使う
# RENDER_SERVICE_NAME サービス名
# RENDER_GIT_COMMIT   デプロイ元のコミット。ローカルでは "dev" になる


# =============================================================================
# 最短の立ち上げ手順
# =============================================================================
#
#   1) ビルドとテストだけなら **環境変数は一切要らない**
#        cargo test
#
#   2) 画面を出すなら、必須2つ + AUTH_PASSWORD を入れる
#        GOOGLE_SA_KEY_B64 / SPREADSHEET_ID / AUTH_PASSWORD
#        cargo run
#
#   3) 置き場所の注意 — 🔴 2026-09-20 に訂正
#      ここには「OneDrive / iCloud Drive / Dropbox の配下だと cargo build が
#      通らない」と書いてあったが、**これは誤り**。同期は関係ない。
#
#      真因は**パスに日本語が入っていること**。mingw の ld.exe が
#      非ASCII のパスを開けず、リンクの段階で落ちる。
#      (日本語パス 3回中 3回失敗 / ASCII パス 2回中 2回成功。実測)
#
#      なので、同期されない場所へ移しても**パスが日本語のままなら直らない**し、
#      OneDrive 配下でも**パスが ASCII なら通る**。
#      日本語パスのまま作業するなら、ビルドの出力先だけ ASCII に逃がす:
#        CARGO_TARGET_DIR=C:/temp/hr_target cargo build
# =============================================================================
